{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "_comment": "Tier 3: Complex Games - Diner Dash, RPG Inventory, Platformer. Estimated 30-100 iterations, $20-100 cost",
  "_complexity": {
    "mechanics_count": "15-50+",
    "state_machines": "5-15",
    "files_expected": "20-50+",
    "estimated_iterations": "30-100",
    "estimated_cost": "$20-100+"
  },
  "agents": {
    "Sisyphus": {
      "model": "openai/gpt-5.2",
      "description": "Main work - GPT-5.2 for sustained reliability"
    },
    "Sisyphus-Junior": {
      "model": "google/antigravity-gemini-3-flash",
      "description": "Parallel subtasks at scale"
    },
    "Prometheus (Planner)": {
      "model": "openai/gpt-5.2",
      "description": "Planning - GPT-5.2 for complex architecture"
    },
    "Metis (Plan Consultant)": {
      "model": "google/antigravity-gemini-3-flash",
      "description": "Plan iteration"
    },
    "Momus (Plan Reviewer)": {
      "model": "openai/gpt-5.2",
      "description": "Review - GPT-5.2 catches edge cases"
    },
    "explore": {
      "model": "opencode/grok-code"
    },
    "oracle": {
      "model": "openai/gpt-5.2",
      "description": "Deep analysis - GPT-5.2 for game systems"
    },
    "frontend-ui-ux-engineer": {
      "model": "google/antigravity-gemini-3-flash",
      "description": "UI implementation"
    }
  },
  "categories": {
    "quick": {
      "model": "github-copilot/gpt-4o-mini",
      "temperature": 0.3
    },
    "general": {
      "model": "google/antigravity-gemini-3-flash",
      "temperature": 0.5
    },
    "ultrabrain": {
      "model": "openai/gpt-5.2",
      "temperature": 0.7
    },
    "most-capable": {
      "model": "openai/gpt-5.2",
      "temperature": 0.7
    }
  },
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 100
  },
  "background_task": {
    "defaultConcurrency": 8,
    "modelConcurrency": {
      "openai/gpt-5.2": 2,
      "google/antigravity-gemini-3-flash": 5,
      "github-copilot/gpt-4o-mini": 10
    }
  },
  "experimental": {
    "preemptive_compaction": true,
    "preemptive_compaction_threshold": 0.80
  }
}
